rules_version = '2';
service cloud_firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    // Сайт зөвхөн event бичнэ, хэн ч уншиж чадахгүй (та Firebase Console-оос харна)
    match /events/{id} {
      allow create: if request.resource.data.type in ['view', 'checkout']
                    && request.resource.data.keys().size() < 12
                    && request.resource.data.slug is string
                    && request.resource.data.slug.size() < 80;
      allow read, update, delete: if false;
    }

    // Бараа: хүн бүр уншина, зөвхөн админ нэмж/засна (/admin хуудас)
    match /products/{slug} {
      allow read: if true;
      allow write: if isAdmin()
                   && slug.matches('^[a-z0-9-]{2,60}$');
    }

    // Админы жагсаалт: Console-оос гараар нэмнэ. Хүн өөрийнхөө баримтыг л уншина.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
