# Firebase — хоосон үлдээвэл src/lib/firebase.js доторх olzstore төслийн config ашиглагдана.
# Өөр Firebase төсөл рүү шилжих бол энд бичнэ.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Cloudinary — /admin хуудаснаас зураг, бичлэг хуулахад хэрэгтэй
# Cloud name: Cloudinary Dashboard-ийн дээд хэсэгт бичээстэй
# Upload preset: Settings → Upload → Upload presets → Add → Signing mode = Unsigned
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Vercel дээрх домэйн (FB preview зурагт хэрэгтэй), жишээ: https://olz.vercel.app
VITE_SITE_URL=
